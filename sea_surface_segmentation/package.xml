<?xml version="1.0"?>
<package format="2">
  <name>sea_surface_segmentation</name>
  <version>0.0.0</version>
  <description>Package that compines eWaRS and depthai_ros to perform segmentation on an Luxonis Oak camera.</description>

  <maintainer email="roland@ccom.unh.edu">Roland Arsenault</maintainer>

  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>camera_info_manager</depend>
  <depend>cv_bridge</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>depthai</depend>
  <depend>depthai_bridge</depend>
  <depend>depthai_marine</depend>
  <depend>grid_map_core</depend>
  <depend>image_geometry</depend>
  <depend>libopencv-dev</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rosbag2_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>ros2bag</test_depend>
  <test_depend>rosbag2_storage_mcap</test_depend>
  <test_depend>sensor_msgs_py</test_depend>
  <test_depend>tf2</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
